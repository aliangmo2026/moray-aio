# moray-aio 环境变量示例。
# 本服务不会自动加载 .env（MVP 未引入 python-dotenv）：
# 复制为 .env 后，用 PowerShell 启动前手动注入，例如：
#   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([A-Z0-9_]+)\s*=\s*(.*)\s*$') { [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2], 'Process') } }
# 或直接用系统环境变量覆盖。

# ---- 服务 ----
MORAY_AIO_HOST=127.0.0.1
MORAY_AIO_PORT=8020

# ---- 日志分析（默认指向 MoRay 主项目的错误日志）----
MORAY_AIO_LOG_PATH=D:\MoRay\logs\moray.err.log
MORAY_AIO_RECENT_ERROR_LIMIT=10
# 单次扫描的最大字节数（从文件尾部向前，默认 5MB）
MORAY_AIO_MAX_SCAN_BYTES=5242880
# 只读白名单根目录，分号分隔；所有工具的 path/dir 必须落在其中
MORAY_AIO_READONLY_ROOTS=D:\MoRay\logs

# ---- Ollama 本地大模型（不可用时自动走启发式兜底）----
MORAY_AIO_OLLAMA_URL=http://127.0.0.1:11434
MORAY_AIO_OLLAMA_MODEL=qwen2.5:7b
MORAY_AIO_OLLAMA_TIMEOUT=120
# Ollama 主机白名单（SSRF 防护，替换语义）：ollama_url 的主机必须命中其中之一
MORAY_AIO_OLLAMA_ALLOWED_HOSTS=127.0.0.1;localhost;::1

# ---- 自我迭代内核 ----
MORAY_AIO_MAX_ITERATIONS=4
# 只读工具是否自动批准（false 时全部任务等人工审批）
MORAY_AIO_AUTO_APPROVE_READONLY=true
MORAY_AIO_MEMORY_DB_PATH=data/memory.sqlite3
# 异步执行线程池大小（POST /episodes 立即 202，后台跑内核）
MORAY_AIO_ASYNC_WORKERS=2

# ---- 日志滚动聚合（可选）：配置了 LOG_DIR 就按 glob 跨文件聚合读取 ----
# 留空则回退到单文件模式（只读 MORAY_AIO_LOG_PATH）
MORAY_AIO_LOG_DIR=
# 滚动文件 glob，例如匹配 moray.err.log / moray.err.log.1 / moray.err.2026-10-24.log
MORAY_AIO_LOG_GLOB_PATTERN=moray.err.log*

# ---- 错误聚类：喂给 LLM 的最大类数 ----
MORAY_AIO_CLUSTER_TOP_N=10

# ---- 只读系统探针 ----
# 探针可连的主机白名单（分号分隔）；默认仅环回地址，绝不外连
MORAY_AIO_PROBE_HOST_WHITELIST=127.0.0.1;localhost;::1
# process_list 返回条数上限（防爆量）
MORAY_AIO_PROBE_MAX_PROCESSES=50
# 探针 raw_output 字节上限
MORAY_AIO_PROBE_OUTPUT_MAX_BYTES=4096

# ---- 插件目录（可选，分号分隔）：扫描 *.py 加载 BaseTool 子类为外部工具 ----
# 例：MORAY_AIO_PLUGIN_DIRS=examples 会加载 examples\dummy_echo_plugin.py
MORAY_AIO_PLUGIN_DIRS=

# ---- 生产级基础设施（v0.6.0）----
# 持久化：DSN 非空 → Postgres（需 pip install -r requirements-optional.txt）；为空 → SQLite
MORAY_AIO_DB_DSN=
# Token 预算熔断：单个 episode 的 LLM 用量上限，超限立即 FAILED
MORAY_AIO_MAX_TOKENS_PER_EPISODE=50000
# API 鉴权：非空时所有请求（除 GET /health）必须携带 X-API-Key 头（只从环境变量读取）
MORAY_AIO_API_KEY=

# ---- 事件驱动 Watch 模式（v0.7.0）----
# 默认关闭（安全优先）；开启后服务启动即监听日志变化并自动分析
MORAY_AIO_WATCH_ENABLED=false
MORAY_AIO_WATCH_POLL_INTERVAL_SECONDS=2
# 可选 JSON 数组覆盖默认触发规则（rapid_error_burst/critical_keywords/error_spike）
MORAY_AIO_WATCH_RULES_CONFIG=
# 告警推送：console;webhook;file（分号分隔）
MORAY_AIO_NOTIFIER_TYPES=console
# Webhook 地址 + 域名白名单（白名单为空时 webhook 拒绝工作，fail-closed）
MORAY_AIO_WEBHOOK_URL=
MORAY_AIO_WEBHOOK_ALLOWED_HOSTS=
# FileNotifier 的告警日志（唯一允许写入的文件，绝不碰被监控日志）
MORAY_AIO_ALERTS_LOG_PATH=data/alerts.log
