# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
# 打包产物（python -m build 输出；发布走 twine 上传 dist/）
build/
dist/

# 运行时数据
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
.backup/

# 本地配置
.env

# 编辑器
.vscode/
.idea/
# Security plugin workspace (never commit)
/.mimosa/
*.json
# 混沌演练/实测证据 JSON 刻意入库（docs/assets）
!docs/assets/*.json
# WorkBuddy 连接器接入包刻意入库
!workbuddy-connector/*.json
